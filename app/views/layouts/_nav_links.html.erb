<% if @round.present? && signed_in? %>
  <% if current_user.audience?(@round) %>
    <%= link_to t(".vote"), round_agenda_items_path(@round), class: "#{class_name_by_tab(round_agenda_items_path(@round))} #{extra_class}" %>
  <% end %>
  <% if current_user.owner?(@round) %>
    <%= link_to t(".result"), owner_round_results_path(@round), class: "#{class_name_by_tab(owner_round_results_path(@round))} #{extra_class}" %>
  <% end %>
<% end %>

<% if admin_user? %>
  <%= link_to t(".users"), users_path, class: "#{class_name_by_tab(users_path)} #{extra_class}" %>
  <%= link_to t(".chronicle"), admin_dashboard_path, class: "#{class_name_by_tab(admin_dashboard_path)} #{extra_class}" %>
<% end %>
