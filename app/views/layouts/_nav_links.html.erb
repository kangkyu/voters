<!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
<%= link_to "New Meeting", new_round_path, class: "#{class_name_by_tab(new_round_path)} #{extra_class}" %>

<% if @round.present? && signed_in? %>
  <% if current_user.audience?(@round) %>
    <%= link_to "Vote", round_agenda_items_path(@round), class: "#{class_name_by_tab(round_agenda_items_path(@round))} #{extra_class}" %>
  <% end %>
  <% if current_user.owner?(@round) %>
    <%= link_to "Result", owner_round_results_path(@round), class: "#{class_name_by_tab(owner_round_results_path(@round))} #{extra_class}" %>
  <% end %>
<% end %>

<% if admin_user? %>
  <%= link_to "Users", users_path, class: "#{class_name_by_tab(users_path)} #{extra_class}" %>
  <%= link_to "Chronicle", admin_dashboard_path, class: "#{class_name_by_tab(admin_dashboard_path)} #{extra_class}" %>
<% end %>
