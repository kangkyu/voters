<!-- Hero -->
<section class="mx-auto max-w-6xl px-6 py-20 sm:py-28 grid gap-14 lg:grid-cols-2 lg:items-center">
  <div>
    <p class="inline-flex rounded-full bg-rose-50 px-3 py-1 text-xs font-medium text-rose-700 dark:bg-rose-950 dark:text-rose-300">Voting for any meeting</p>
    <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-5xl">Every voice counted.<br>No hands, no paper slips.</h1>
    <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">Open a meeting, invite everyone in the room, and vote on each agenda item from your phones. Motions and elections, tallied instantly.</p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <%= link_to "Open a meeting", new_round_path, class: "rounded-md bg-rose-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% unless signed_in? %>
        <%= link_to "Create an account →", register_path, class: "text-sm font-semibold text-gray-900 hover:text-rose-600 dark:text-gray-100" %>
      <% end %>
    </div>
  </div>

  <!-- Preview card -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <div class="flex items-center justify-between text-xs text-gray-500">
      <span>Annual General Meeting</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-green-500"></span>12 joined</span>
    </div>
    <div class="mt-4 rounded-xl bg-white p-5 dark:bg-gray-950">
      <p class="text-xs font-semibold uppercase tracking-wide text-rose-600">Motion · Item 3</p>
      <p class="mt-2 font-medium">Approve the 2027 budget as presented</p>
      <div class="mt-4 space-y-3 text-sm">
        <div>
          <div class="flex justify-between"><span>Approve</span><span class="font-medium">9</span></div>
          <div class="mt-1 h-2 rounded-full bg-gray-100 dark:bg-gray-800"><div class="h-2 w-3/4 rounded-full bg-rose-600"></div></div>
        </div>
        <div>
          <div class="flex justify-between"><span>Against</span><span class="font-medium">3</span></div>
          <div class="mt-1 h-2 rounded-full bg-gray-100 dark:bg-gray-800"><div class="h-2 w-1/4 rounded-full bg-gray-400"></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="border-t border-gray-100 bg-gray-50 py-20 dark:border-gray-800 dark:bg-gray-900">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl font-semibold tracking-tight">How it works</h2>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      <div>
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-600 font-semibold text-white">1</div>
        <h3 class="mt-4 font-semibold">Open a meeting</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">The chair or organizer creates a meeting and sets up the agenda items to vote on.</p>
      </div>
      <div>
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-600 font-semibold text-white">2</div>
        <h3 class="mt-4 font-semibold">Invite attendees</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">Everyone signs in and joins the meeting, so each person gets exactly one vote.</p>
      </div>
      <div>
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-rose-600 font-semibold text-white">3</div>
        <h3 class="mt-4 font-semibold">Vote item by item</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">As each agenda item comes up, members cast their vote and see the result right away.</p>
      </div>
    </div>
  </div>
</section>

<!-- Vote types -->
<section class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-3xl font-semibold tracking-tight">Two kinds of agenda items</h2>
    <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">Covers what most meetings actually decide.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 p-8 dark:border-gray-800">
        <p class="text-3xl">✅</p>
        <h3 class="mt-4 text-xl font-semibold">Motion</h3>
        <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-400">A proposal put to the room. Each member votes <span class="font-medium text-gray-900 dark:text-gray-100">Approve</span> or <span class="font-medium text-gray-900 dark:text-gray-100">Against</span>. Use it for budgets, bylaws, policies and resolutions.</p>
        <div class="mt-6 flex gap-3">
          <span class="rounded-md bg-rose-600 px-4 py-2 text-sm font-medium text-white">Approve</span>
          <span class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium dark:border-gray-700">Against</span>
        </div>
      </div>
      <div class="rounded-2xl border border-gray-200 p-8 dark:border-gray-800">
        <p class="text-3xl">🙋</p>
        <h3 class="mt-4 text-xl font-semibold">Election</h3>
        <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-400">Choose a person for a role. Each member picks <span class="font-medium text-gray-900 dark:text-gray-100">one candidate</span>. Use it for chair, treasurer, secretary or any open seat.</p>
        <div class="mt-6 space-y-2 text-sm">
          <div class="flex items-center gap-3 rounded-md border border-rose-600 px-4 py-2"><span class="h-3 w-3 rounded-full bg-rose-600"></span>Candidate A</div>
          <div class="flex items-center gap-3 rounded-md border border-gray-300 px-4 py-2 dark:border-gray-700"><span class="h-3 w-3 rounded-full border border-gray-400"></span>Candidate B</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="border-t border-gray-100 bg-gray-50 py-16 dark:border-gray-800 dark:bg-gray-900">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="text-sm font-medium text-gray-500">Made for</p>
    <p class="mt-3 text-lg font-medium">Boards · Clubs · HOAs · Student councils · Associations · Churches · Unions</p>
  </div>
</section>

<!-- CTA -->
<section class="py-20">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Ready for your next meeting?</h2>
    <p class="mt-4 text-gray-600 dark:text-gray-400">Set it up in a minute. Your attendees just sign in and vote.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <%= link_to "Open a meeting", new_round_path, class: "rounded-md bg-rose-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-rose-500" %>
      <% unless signed_in? %>
        <%= link_to "Sign in to join", new_session_path, class: "rounded-md border border-gray-300 px-5 py-3 text-sm font-semibold hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-900" %>
      <% end %>
    </div>
  </div>
</section>
