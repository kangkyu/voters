<div class="mx-auto max-w-3xl">
  <h1 class="page-title"><%= t(".title") %></h1>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <div class="card p-6">
      <p class="text-sm text-stone-500 dark:text-stone-400"><%= t(".users") %></p>
      <p class="mt-2 text-3xl font-semibold tabular-nums"><%= t(".user_count", count: @users) %></p>
    </div>
    <div class="card p-6">
      <p class="text-sm text-stone-500 dark:text-stone-400"><%= t(".meetings") %></p>
      <p class="mt-2 text-3xl font-semibold tabular-nums"><%= t(".meeting_count", count: @rounds) %></p>
    </div>
  </div>
</div>
