<div class="mx-auto max-w-sm py-6">
  <h1 class="page-title">Sign In</h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
    New here? <%= link_to "Create an account", register_path, class: "link" %>
  </p>

  <div class="card mt-8 p-6">
    <%= form_with url: session_path, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, autofocus: true, required: true, autocomplete: "username", class: "form-input" %>
      </div>
      <div>
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", class: "form-input" %>
      </div>
      <%= f.submit "Sign In", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
