<li id="<%= dom_id(agenda_item) %>" class="card p-5">
  <p class="eyebrow"><%= agenda_item.election? ? "Election" : "Motion" %></p>
  <h2 class="mt-1 font-medium"><%= agenda_item.name %></h2>
  <% if agenda_item.location.present? %>
    <p class="text-sm text-stone-500 dark:text-stone-400"><%= agenda_item.location %></p>
  <% end %>
  <div class="mt-4">
    <%= render "activity/votes", agenda_item: agenda_item %>
  </div>
</li>
