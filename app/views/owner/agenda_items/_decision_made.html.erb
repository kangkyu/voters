<%= turbo_frame_tag agenda_item, :decision_made do %>
  <%= form_with model: agenda_item, url: owner_round_agenda_item_path(agenda_item.round, agenda_item), method: :patch, data: { controller: "auto-submit" } do |f| %>
    <label class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-medium <%= agenda_item.decision_made? ? "text-stone-900 dark:text-white" : "text-stone-500 dark:text-stone-400" %>">
      <%= f.check_box :decision_made, data: { action: "auto-submit#submit" }, class: "h-4 w-4 rounded border-stone-300 text-blue-800 focus:ring-blue-700 dark:border-stone-700 dark:bg-stone-950" %>
      <%= t("decisions.decision_made") %>
    </label>
  <% end %>
<% end %>
