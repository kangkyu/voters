<%= turbo_frame_tag agenda_item, :decision_made do %>
  <%= form_with model: agenda_item, url: owner_round_agenda_item_path(agenda_item.round, agenda_item), method: :patch, data: { controller: "auto-submit" } do |f| %>
    <label class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-medium <%= agenda_item.decision_made? ? "text-gray-900 dark:text-white" : "text-gray-500 dark:text-gray-400" %>">
      <%= f.check_box :decision_made, data: { action: "auto-submit#submit" }, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-900" %>
      Decision made
    </label>
  <% end %>
<% end %>
