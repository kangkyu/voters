<%= form_with model: agenda_item, url: owner_round_agenda_items_path(round), id: "new_agenda_item_form", class: "flex flex-col gap-4", data: { controller: "kind-fields" } do |f| %>
  <h3 class="text-lg font-semibold">Add an agenda item</h3>
  <% if agenda_item.errors.any? %>
    <ul class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
      <% agenda_item.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
    <div class="sm:col-span-2 lg:col-span-1">
      <%= f.label :kind, "Type", class: "form-label" %>
      <%= f.select :kind, [["Motion (favor / against)", "motion"], ["Election (pick one candidate)", "election"]], {}, data: { kind_fields_target: "kind", action: "kind-fields#toggle" }, class: "form-input" %>
    </div>
    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, required: true, class: "form-input" %>
    </div>
    <div>
      <%= f.label :location, class: "form-label" %>
      <%= f.text_field :location, class: "form-input" %>
    </div>
    <div class="sm:col-span-2 lg:col-span-1" data-kind-fields-target="motion" <%= "hidden" if agenda_item.election? %>>
      <%= f.label :decision_rule, "Decision vote", class: "form-label" %>
      <%= f.select :decision_rule, [["Majority (more than 1/2 approve)", "majority"], ["Two-thirds (2/3 approve)", "two_thirds"]], { include_blank: "None (tally only)" }, class: "form-input" %>
    </div>
    <div class="sm:col-span-2 lg:col-span-1" data-kind-fields-target="election" <%= "hidden" unless agenda_item.election? %>>
      <%= f.label :candidate_names, "Candidates", class: "form-label" %>
      <%= f.text_area :candidate_names, rows: 4, placeholder: "One name per line", class: "form-input" %>
      <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">One name per line. Most votes wins.</p>
    </div>
  </div>
  <%= f.submit "Add", class: "btn-primary w-full" %>
<% end %>
