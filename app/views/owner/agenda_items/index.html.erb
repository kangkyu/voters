<div class="max-w-5xl mx-auto mt-5">
  <h2 class="text-2xl font-semibold mb-6">“<%= link_to @round.title, round_path(@round), class: "hover:underline" %>” meeting agenda items</h2>

  <div class="grid gap-6 lg:grid-cols-3 lg:items-start">
    <section class="lg:col-span-2">
      <%= render "list", agenda_items: @agenda_items %>
    </section>

    <aside class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm lg:sticky lg:top-6 dark:border-gray-700 dark:bg-gray-800">
      <%= render "form", round: @round, agenda_item: AgendaItem.new %>
    </aside>
  </div>
</div>
