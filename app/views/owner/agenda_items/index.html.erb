<div class="mx-auto max-w-5xl">
  <p class="eyebrow">Agenda items</p>
  <h1 class="page-title mt-2">“<%= link_to @round.title, round_path(@round), class: "hover:text-blue-800 dark:hover:text-blue-400" %>”</h1>

  <div class="mt-8 grid gap-6 lg:grid-cols-3 lg:items-start">
    <section class="lg:col-span-2">
      <%= render "list", agenda_items: @agenda_items %>
    </section>

    <aside class="card p-6 lg:sticky lg:top-6">
      <%= render "form", round: @round, agenda_item: AgendaItem.new %>
    </aside>
  </div>
</div>
