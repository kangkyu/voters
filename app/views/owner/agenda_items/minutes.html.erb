<div data-controller="print" class="mb-8 flex items-center justify-between gap-4 print:hidden">
  <%= link_to "← Results", owner_round_results_path(@round), class: "link text-sm" %>
  <button type="button" data-action="print#print" class="btn-primary">Print</button>
</div>

<header class="border-b-2 border-stone-900 pb-4">
  <p class="text-xs font-semibold uppercase tracking-widest text-stone-600">Minutes of the meeting</p>
  <h1 class="mt-2 text-3xl font-semibold">“<%= @round.title %>”</h1>
  <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
    <dt class="text-stone-600">Opened</dt>
    <dd><%= l @round.created_at.to_date, format: :long %></dd>
    <dt class="text-stone-600">Organizer</dt>
    <dd><%= @round.owner.username %></dd>
  </dl>
</header>

<section class="mt-8">
  <h2 class="text-lg font-semibold">Attendance · <%= pluralize(@audiences.size, "attendee") %></h2>
  <% if @audiences.any? %>
    <p class="attendees mt-2 text-sm leading-relaxed"><%= @audiences.map(&:name).to_sentence %></p>
  <% else %>
    <p class="mt-2 text-sm text-stone-600">No attendees joined.</p>
  <% end %>
</section>

<section class="mt-8">
  <h2 class="text-lg font-semibold">Agenda</h2>
  <% if @agenda_items.empty? %>
    <p class="mt-2 text-sm text-stone-600">No agenda items.</p>
  <% end %>
  <ol class="mt-3 flex flex-col">
    <% @agenda_items.each.with_index(1) do |agenda_item, number| %>
      <li id="<%= dom_id(agenda_item, :minutes) %>" class="minutes-item break-inside-avoid border-t border-stone-300 py-4">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="font-semibold"><%= number %>. <%= agenda_item.name %></h3>
          <span class="shrink-0 text-xs uppercase tracking-wide text-stone-600">
            <%= agenda_item.election? ? "Election" : "Motion" %><% if agenda_item.decision_rule %> · <%= agenda_item.decision_rule_label %> of votes cast<% end %>
          </span>
        </div>
        <% if agenda_item.subtitle.present? %>
          <p class="text-sm text-stone-600"><%= agenda_item.subtitle %></p>
        <% end %>

        <% if agenda_item.election? %>
          <% leaders = agenda_item.leading_candidates %>
          <p class="outcome mt-2 text-sm font-semibold">
            <% if leaders.empty? %>
              No votes cast
            <% elsif leaders.one? %>
              Elected: <%= leaders.first.name %>
            <% else %>
              Tie: <%= leaders.map(&:name).to_sentence %>
            <% end %>
          </p>
          <table class="mt-2 w-full text-sm">
            <tbody>
              <% agenda_item.candidates.each do |candidate| %>
                <tr class="border-b border-stone-200">
                  <td class="py-1"><%= candidate.name %></td>
                  <td class="py-1 text-right tabular-nums"><%= agenda_item.candidate_vote_count(candidate) %></td>
                </tr>
              <% end %>
              <tr class="border-b border-stone-200 text-stone-600">
                <td class="py-1">Abstain</td>
                <td class="py-1 text-right tabular-nums"><%= agenda_item.abstain_count %></td>
              </tr>
              <tr class="text-stone-600">
                <td class="py-1">Not voted</td>
                <td class="py-1 text-right tabular-nums"><%= agenda_item.not_voted_count %></td>
              </tr>
            </tbody>
          </table>
        <% else %>
          <p class="outcome mt-2 text-sm font-semibold"><%= { passed: "Passed", failed: "Failed", pending: "No votes cast" }.fetch(agenda_item.decision, "Tally only") %></p>
          <p class="tally mt-1 text-sm tabular-nums">
            Favor <%= agenda_item.favor_count %> · Against <%= agenda_item.against_count %> · Abstain <%= agenda_item.abstain_count %> · Not voted <%= agenda_item.not_voted_count %>
          </p>
        <% end %>

        <% unless agenda_item.decision_made? %>
          <p class="mt-2 text-xs italic text-stone-600">Voting was still open when these minutes were printed.</p>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>

<footer class="mt-10 border-t border-stone-300 pt-3 text-xs text-stone-500">
  Printed <%= l Time.current, format: :long %>
</footer>
