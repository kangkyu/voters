<%= turbo_frame_tag @audience, :name do %>
  <%= form_with model: @audience, url: owner_round_audience_path(@round, @audience), class: "flex flex-wrap items-center gap-2" do |f| %>
    <%= f.label :name, t("owner.audiences.index.name"), class: "sr-only" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "form-input w-48 #{"border-red-500" if @audience.errors.any?}" %>
    <%= f.submit t("common.save"), class: "btn-primary" %>
    <%= link_to t("common.cancel"), owner_round_audiences_path(@round), class: "text-sm font-medium text-stone-500 hover:text-stone-800 dark:text-stone-400 dark:hover:text-stone-200" %>
    <% @audience.errors.full_messages.each do |message| %>
      <p class="w-full text-xs text-red-700 dark:text-red-300"><%= message %></p>
    <% end %>
  <% end %>
<% end %>
