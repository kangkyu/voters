<div class="mx-auto max-w-3xl">
  <p class="eyebrow">Attendees</p>
  <h1 class="page-title mt-2">“<%= link_to @round.title, round_path(@round), class: "hover:text-rose-600 dark:hover:text-rose-400" %>”</h1>

  <div class="mt-8">
    <% if @audiences.any? %>
      <div class="card overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
          <thead>
            <tr>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">ID</th>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">Name</th>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">Username</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @audiences.each do |audience| %>
              <tr>
                <td class="px-5 py-3 tabular-nums text-gray-500 dark:text-gray-400"><%= audience.id %></td>
                <td class="px-5 py-3 font-medium">“<%= audience.name %>”</td>
                <td class="px-5 py-3 text-gray-500 dark:text-gray-400"><%= audience.user.username %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="empty-state">
        No attendees yet. Share the meeting link to invite them.
      </p>
    <% end %>
  </div>
</div>
