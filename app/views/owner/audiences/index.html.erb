<div class="mx-auto max-w-3xl">
  <p class="eyebrow">Attendees</p>
  <h1 class="page-title mt-2">“<%= link_to @round.title, round_path(@round), class: "hover:text-blue-800 dark:hover:text-blue-400" %>”</h1>

  <div class="mt-8">
    <% if @audiences.any? %>
      <div class="card overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200 text-sm dark:divide-stone-800">
          <thead>
            <tr>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300">ID</th>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300">Attendee Name</th>
              <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300">Username</th>
              <th scope="col" class="px-5 py-3"><span class="sr-only">Remove</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 dark:divide-stone-800">
            <% @audiences.each do |audience| %>
              <tr>
                <td class="px-5 py-3 tabular-nums text-stone-500 dark:text-stone-400"><%= audience.id %></td>
                <td class="px-5 py-3 font-medium">“<%= audience.name %>”</td>
                <td class="px-5 py-3 text-stone-500 dark:text-stone-400"><%= audience.user.username %></td>
                <td class="px-5 py-3 text-right">
                  <%= button_to "Remove", owner_round_audience_path(@round, audience), method: :delete,
                        form: { data: { turbo_confirm: "Remove “#{audience.name}” from this meeting? Their votes in it will be deleted." } },
                        class: "text-sm font-medium text-stone-500 hover:text-red-600 dark:text-stone-400 dark:hover:text-red-400" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="empty-state">
        No attendees yet. Share the meeting link to invite them.
      </p>
    <% end %>
  </div>
</div>
