<%= turbo_frame_tag "#{dom_id(agenda_item)}_votes" do %>
  <% vote = agenda_item.my_vote %>
  <% closed = agenda_item.decision_made? %>
  <% if closed %>
    <p class="mb-3 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-gray-600 dark:bg-gray-800 dark:text-gray-300">Decision made</span>
      Voting is closed.
    </p>
  <% end %>
  <%# Each option: label, whether it is my vote, and params to cast it %>
  <% options = if agenda_item.election?
       agenda_item.candidates.map { |candidate| [candidate.name, vote&.candidate_id == candidate.id, { candidate_id: candidate.id }] }
     else
       [["Favor", vote&.favor?, { choice: "favor" }], ["Against", vote&.against?, { choice: "against" }]]
     end %>
  <% if agenda_item.election? %>
    <%# Candidates stack like radio rows %>
    <div class="flex flex-col gap-2">
      <% options.each do |label, selected, vote_params| %>
        <% row_class = "flex w-full items-center gap-3 rounded-md border px-4 py-2 text-left text-sm #{selected ? "border-rose-600 bg-rose-50 font-medium dark:bg-rose-950/40" : "border-gray-300 dark:border-gray-700"}" %>
        <% dot = tag.span(class: "h-3 w-3 shrink-0 rounded-full #{selected ? "bg-rose-600" : "border border-gray-400"}") %>
        <% if closed %>
          <%# Closed: keep showing my vote, but nothing can be clicked %>
          <button type="button" disabled class="<%= row_class %> cursor-not-allowed opacity-60"><%= dot %><%= label %></button>
        <% elsif selected %>
          <%= button_to round_agenda_item_vote_path(agenda_item.round, agenda_item, vote), method: :delete, class: row_class do %><%= dot %><%= label %><% end %>
        <% else %>
          <%= button_to round_agenda_item_votes_path(agenda_item.round, agenda_item), params: vote_params, class: "#{row_class} hover:border-rose-600" do %><%= dot %><%= label %><% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-wrap gap-3">
      <% options.each do |label, selected, vote_params| %>
        <% button_class = "rounded-md border px-5 py-2 text-sm font-medium #{selected ? "border-rose-600 bg-rose-600 text-white" : "border-gray-300 dark:border-gray-700"}" %>
        <% if closed %>
          <%# Closed: keep showing my vote, but nothing can be clicked %>
          <button type="button" disabled class="<%= button_class %> cursor-not-allowed opacity-60"><%= label %></button>
        <% elsif selected %>
          <%= button_to label, round_agenda_item_vote_path(agenda_item.round, agenda_item, vote), method: :delete, class: "#{button_class} hover:bg-rose-500" %>
        <% else %>
          <%= button_to label, round_agenda_item_votes_path(agenda_item.round, agenda_item), params: vote_params, class: "#{button_class} hover:border-rose-600 hover:text-rose-600 dark:hover:text-rose-400" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
