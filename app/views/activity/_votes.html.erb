<%= turbo_frame_tag "#{dom_id(contestant)}_votes" do %>
  <div class="flex items-center justify-between">
    <span><%= contestant.name %></span>
    <div class="flex space-x-2">
      <% vote = contestant.my_vote %>
      <% [
           ["favor", "Favor", "border-green-600 bg-green-600 text-white", "border-green-600 text-green-700 hover:bg-green-50 dark:text-green-400 dark:hover:bg-green-900/40"],
           ["against", "Against", "border-red-600 bg-red-600 text-white", "border-red-600 text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/40"]
         ].each do |choice, label, selected_class, unselected_class| %>
        <% if vote&.choice == choice %>
          <%= button_to label, round_contestant_vote_path(contestant.round, contestant, vote), method: :delete,
                class: "px-3 py-1 rounded border font-semibold #{selected_class}" %>
        <% else %>
          <%= button_to label, round_contestant_votes_path(contestant.round, contestant), params: { choice: choice },
                class: "px-3 py-1 rounded border font-semibold #{unselected_class}" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
