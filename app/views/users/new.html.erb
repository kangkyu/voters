<div class="mx-auto max-w-md py-6">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="mt-2 text-base text-stone-600 dark:text-stone-400"><%= t(".intro") %></p>

  <%# Meeting links land here, so returning attendees need a way to sign in they can't miss, above the form on a phone %>
  <div class="mt-5 flex items-center justify-between gap-4 rounded-xl border border-stone-200 bg-stone-100 px-5 py-4 dark:border-stone-800 dark:bg-stone-900/60">
    <div>
      <h2 class="font-sans text-base font-semibold"><%= t(".returning_title") %></h2>
      <p class="text-sm text-stone-600 dark:text-stone-400"><%= t(".returning_body") %></p>
    </div>
    <%= link_to t(".sign_in"), signin_path, class: "btn-secondary shrink-0 px-5 py-2.5 text-base" %>
  </div>

  <div class="card mt-5 p-6">
    <%= form_with model: @user, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :username, class: "form-label text-base" %>
        <%= f.text_field :username, autofocus: true, required: true, autocomplete: "username", class: "form-input py-2.5 text-lg sm:text-lg" %>
      </div>
      <div>
        <%= f.label :password, class: "form-label text-base" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password", class: "form-input py-2.5 text-lg sm:text-lg" %>
      </div>
      <div>
        <%= f.label :locale, class: "form-label text-base" %>
        <%# Each language is named in itself, so it can be found whatever this page is shown in %>
        <%= f.select :locale, I18n.available_locales.map { |locale| [t("language_name", locale: locale), locale] }, {}, class: "form-input py-2.5 text-lg sm:text-lg" %>
        <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".locale_hint") %></p>
      </div>
      <%= f.submit t(".submit"), class: "btn-primary w-full py-3 text-lg" %>
    <% end %>
  </div>
</div>
