<div class="mx-auto max-w-sm py-6">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
    <%= t(".have_one") %> <%= link_to t(".sign_in"), signin_path, class: "link" %>
  </p>

  <div class="card mt-8 p-6">
    <%= form_with model: @user, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, autofocus: true, required: true, autocomplete: "username", class: "form-input" %>
      </div>
      <div>
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password", class: "form-input" %>
      </div>
      <div>
        <%= f.label :locale, class: "form-label" %>
        <%# Each language is named in itself, so it can be found whatever this page is shown in %>
        <%= f.select :locale, I18n.available_locales.map { |locale| [t("language_name", locale: locale), locale] }, {}, class: "form-input" %>
        <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t(".locale_hint") %></p>
      </div>
      <%= f.submit t(".submit"), class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
