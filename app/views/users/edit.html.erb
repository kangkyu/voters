<div class="mx-auto max-w-sm py-6">
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="page-title mt-2"><%= t(".title") %></h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
    <%= t(".intro") %> <%= link_to t(".back"), user_path(@user.another_id), class: "link" %>
  </p>

  <div class="card mt-8 p-6">
    <%= form_with model: @user, url: user_path(@user.another_id), method: :patch, class: "space-y-5" do |f| %>
      <% if @user.errors.any? %>
        <ul class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
      <div>
        <%= f.label :username, class: "form-label" %>
        <%= f.text_field :username, required: true, autocomplete: "username", class: "form-input" %>
      </div>
      <div>
        <%= f.label :password, t(".new_password"), class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
        <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t(".password_hint") %></p>
      </div>
      <div>
        <%= f.label :password_confirmation, class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>
      <div class="border-t border-stone-100 pt-5 dark:border-stone-800">
        <%= f.label :password_challenge, class: "form-label" %>
        <%= f.password_field :password_challenge, required: true, autocomplete: "current-password", class: "form-input" %>
        <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t(".challenge_hint") %></p>
      </div>
      <%= f.submit t("common.save"), class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
