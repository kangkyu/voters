<div class="mx-auto max-w-2xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="page-title"><%= @user.username %></h1>
      <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-900 dark:bg-blue-950 dark:text-blue-300"><%= t("roles.#{@user.user_role}") %></span>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to t(".edit"), edit_user_path(@user.another_id), class: "btn-secondary" %>
      <%= button_to t(".sign_out"), session_path, method: :delete, form: { data: { turbo_confirm: t(".sign_out_confirm", name: current_user.username), confirm_button: t(".sign_out_button") }}, class: "btn-secondary" %>
    </div>
  </div>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".intro") %></p>

  <section class="card mt-8 p-6">
    <h2 class="font-semibold"><%= t(".language") %></h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <% I18n.available_locales.each do |locale| %>
        <% label = t("language_name", locale: locale) %>
        <% if locale == I18n.locale %>
          <button type="button" aria-pressed="true" lang="<%= locale %>" class="rounded-md border border-blue-800 bg-blue-800 px-5 py-2 text-sm font-medium text-white cursor-default"><%= label %></button>
        <% else %>
          <%= button_to label, language_path, method: :patch, params: { locale: locale }, lang: locale,
                class: "rounded-md border border-stone-300 px-5 py-2 text-sm font-medium hover:border-blue-800 hover:text-blue-800 dark:border-stone-700 dark:hover:text-blue-400" %>
        <% end %>
      <% end %>
    </div>
  </section>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <section class="card p-6">
      <h2 class="font-semibold"><%= t(".organize") %></h2>
      <% if @user.rounds.any? %>
        <ul class="mt-3 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <% @user.rounds.each do |round| %>
            <li class="py-2"><%= link_to "“#{round.title}”", round_path(round), class: "link" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400"><%= t(".none_yet") %> <%= link_to t(".open_meeting"), new_round_path, class: "link" %></p>
      <% end %>
    </section>

    <section class="card p-6">
      <h2 class="font-semibold"><%= t(".attend") %></h2>
      <% if @user.audiences.any? %>
        <ul class="mt-3 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <% @user.audiences.each do |audience| %>
            <li class="py-2">
              <%= link_to "“#{audience.round.title}”", round_path(audience.round), class: "link" %>
              <span class="text-stone-500 dark:text-stone-400"><%= t(".as", name: audience.name) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400"><%= t(".attend_none") %></p>
      <% end %>
    </section>
  </div>
</div>
