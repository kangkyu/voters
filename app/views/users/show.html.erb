<div class="mx-auto max-w-2xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <h1 class="page-title"><%= @user.username %></h1>
      <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-900 dark:bg-blue-950 dark:text-blue-300"><%= @user.user_role %></span>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Edit account", edit_user_path(@user.another_id), class: "btn-secondary" %>
      <%= button_to "Sign Out", session_path, method: :delete, form: { data: { turbo_confirm: "Signing out as \"#{current_user.username}\"?", confirm_button: "Sign out" }}, class: "btn-secondary" %>
    </div>
  </div>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Thank you for using this app. This page shows who the current user is.</p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <section class="card p-6">
      <h2 class="font-semibold">Meetings you organize</h2>
      <% if @user.rounds.any? %>
        <ul class="mt-3 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <% @user.rounds.each do |round| %>
            <li class="py-2"><%= link_to "“#{round.title}”", round_path(round), class: "link" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">None yet. <%= link_to "Open a meeting", new_round_path, class: "link" %></p>
      <% end %>
    </section>

    <section class="card p-6">
      <h2 class="font-semibold">Meetings you attend</h2>
      <% if @user.audiences.any? %>
        <ul class="mt-3 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <% @user.audiences.each do |audience| %>
            <li class="py-2">
              <%= link_to "“#{audience.round.title}”", round_path(audience.round), class: "link" %>
              <span class="text-stone-500 dark:text-stone-400">as “<%= audience.name %>”</span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">None yet. Open a meeting link you were sent to join.</p>
      <% end %>
    </section>
  </div>
</div>
