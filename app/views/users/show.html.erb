<div class="max-w-sm rounded overflow-hidden shadow-lg dark:bg-gray-800">
  <div class="px-6 py-4">
    <div class="font-bold text-xl mb-2"><%= @user.username %></div>
    <p class="text-gray-700 text-base dark:text-gray-300">
      Thank you for using this app. This page shows who the current user is.
    </p>
    <% if @user.rounds.any? %>
      <hr class="border-t border-gray-300 my-4 dark:border-gray-600">
      <p class="text-gray-700 text-base dark:text-gray-300">
        <%= user_s_own_rounds(@user.rounds) %>
      </p>
    <% end %>
    <% if @user.audiences.any? %>
      <hr class="border-t border-gray-300 my-4 dark:border-gray-600">
      <p class="text-gray-700 text-base dark:text-gray-300">
        <%= user_s_audiences(@user.audiences) %>
      </p>
    <% end %>
  </div>
  <div class="px-6 pt-4 pb-2">
      <span class="inline-block bg-gray-200 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 dark:bg-gray-700 dark:text-gray-200 mr-2 mb-2"><%= @user.user_role %></span>
  </div>
</div>
<div class="mt-8">
<%= button_to 'Sign Out', session_path, method: :delete, form: { data: { turbo_confirm: "Signing out as \"#{current_user.username}\"?" }}, class: "bg-transparent hover:bg-amber-500 text-amber-700 dark:text-amber-400 font-semibold hover:text-white py-2 px-4 border border-amber-500 hover:border-transparent rounded" %>
</div>
