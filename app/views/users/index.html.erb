<div class="mx-auto max-w-4xl">
  <h1 class="page-title">Users</h1>

  <div class="card mt-8 overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
      <thead>
        <tr>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">User ID</th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">Username</th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">Role</th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-gray-600 dark:text-gray-300">Phone number</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        <% @users.each do |user| %>
          <tr>
            <td class="px-5 py-3 tabular-nums text-gray-500 dark:text-gray-400"><%= user.another_id %></td>
            <td class="px-5 py-3 font-medium"><%= user.username %></td>
            <td class="px-5 py-3"><span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300"><%= user.user_role %></span></td>
            <td class="px-5 py-3 text-gray-500 dark:text-gray-400"><%= user.phone_number %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
