<div class="mx-auto max-w-4xl">
  <h1 class="page-title"><%= t(".title") %></h1>

  <div class="card mt-8 overflow-x-auto">
    <table class="min-w-full divide-y divide-stone-200 text-sm dark:divide-stone-800">
      <thead>
        <tr>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300"><%= t(".user_id") %></th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300"><%= User.human_attribute_name(:username) %></th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300"><%= User.human_attribute_name(:user_role) %></th>
          <th scope="col" class="px-5 py-3 text-left font-semibold text-stone-600 dark:text-stone-300"><%= User.human_attribute_name(:phone_number) %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100 dark:divide-stone-800">
        <% @users.each do |user| %>
          <tr>
            <td class="px-5 py-3 tabular-nums text-stone-500 dark:text-stone-400"><%= user.another_id %></td>
            <td class="px-5 py-3 font-medium"><%= user.username %></td>
            <td class="px-5 py-3"><span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-medium text-stone-700 dark:bg-stone-800 dark:text-stone-300"><%= t("roles.#{user.user_role}") %></span></td>
            <td class="px-5 py-3 text-stone-500 dark:text-stone-400"><%= user.phone_number %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
