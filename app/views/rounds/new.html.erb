<div class="mx-auto max-w-md py-6">
  <h1 class="page-title">Start a meeting</h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Give it a name. You'll add agenda items and invite attendees next.</p>

  <div class="card mt-8 p-6">
    <%= form_with model: @round, url: rounds_path, method: :post, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, autofocus: true, placeholder: "Annual General Meeting", class: "form-input" %>
      </div>
      <%= f.submit "Start", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
