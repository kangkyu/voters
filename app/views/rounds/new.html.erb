<div class="mx-auto max-w-md py-6">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".intro") %></p>

  <div class="card mt-8 p-6">
    <%= form_with model: @round, url: rounds_path, method: :post, class: "space-y-5" do |f| %>
      <% if @round.errors.any? %>
        <ul class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
          <% @round.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
      <div>
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, autofocus: true, placeholder: t(".title_placeholder"), class: "form-input" %>
      </div>
      <div data-controller="reveal" class="space-y-3">
        <label class="flex items-start gap-2 text-sm">
          <%= f.check_box :organizer_votes, data: { reveal_target: "toggle", action: "reveal#toggle" }, class: "mt-0.5 h-4 w-4 rounded border-stone-300 text-blue-800 focus:ring-blue-700 dark:border-stone-700 dark:bg-stone-950" %>
          <span>
            <%= t(".organizer_votes") %>
            <span class="block text-xs text-stone-500 dark:text-stone-400"><%= t(".organizer_votes_hint") %></span>
          </span>
        </label>
        <div data-reveal-target="content" <%= "hidden" unless @round.organizer_votes %>>
          <%= f.label :organizer_name, class: "form-label" %>
          <%= f.text_field :organizer_name, required: true, disabled: !@round.organizer_votes, class: "form-input" %>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= t(".organizer_name_hint") %></p>
        </div>
      </div>
      <div>
        <label class="flex items-start gap-2 text-sm">
          <%= f.check_box :require_passcode, class: "mt-0.5 h-4 w-4 rounded border-stone-300 text-blue-800 focus:ring-blue-700 dark:border-stone-700 dark:bg-stone-950" %>
          <span>
            <%= t(".require_passcode") %>
            <span class="block text-xs text-stone-500 dark:text-stone-400"><%= t(".require_passcode_hint") %></span>
          </span>
        </label>
      </div>
      <%= f.submit t(".submit"), class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
