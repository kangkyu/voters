<div class="mx-auto max-w-3xl">
  <p class="eyebrow">Meeting</p>
  <h1 class="page-title mt-2">“<%= @round.title %>”</h1>

  <% if current_user.owner?(@round) %>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">You're the organizer of this meeting.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <section class="card p-6">
        <h2 class="font-semibold">Run the meeting</h2>
        <ul class="mt-4 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <li><%= link_to "Agenda items", owner_round_agenda_items_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <li><%= link_to "Attendees", owner_round_audiences_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <li><%= link_to "Results", owner_round_results_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
        </ul>
      </section>

      <section class="card p-6" data-controller="clipboard">
        <h2 class="font-semibold">Invite attendees</h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Share this page's address. Attendees sign in and join from there.</p>
        <p class="mt-4 break-all rounded-md bg-stone-50 px-3 py-2 font-mono text-xs text-stone-700 dark:bg-stone-950 dark:text-stone-300" data-clipboard-target="source"><%= @round.url %></p>
        <button type="button" data-clipboard-target="button" data-action="clipboard#copy" class="btn-secondary mt-4">Copy link</button>

        <div id="passcode" class="mt-6 border-t border-stone-100 pt-5 dark:border-stone-800">
          <% if @round.passcode.present? %>
            <p class="text-sm text-stone-600 dark:text-stone-400">Passcode to join. Announce it at the meeting.</p>
            <p class="passcode mt-2 font-mono text-3xl font-semibold tracking-[0.3em]"><%= @round.passcode %></p>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= button_to "New code", owner_round_passcode_path(@round), method: :post, class: "btn-secondary", form: { data: { turbo_confirm: "Make a new passcode? The current one stops working for anyone who hasn't joined yet." } } %>
              <%= button_to "Turn off", owner_round_passcode_path(@round), method: :delete, class: "btn-secondary", form: { data: { turbo_confirm: "Let anyone with the link join without a passcode?" } } %>
            </div>
          <% else %>
            <p class="text-sm text-stone-600 dark:text-stone-400">Anyone with the link can join.</p>
            <%= button_to "Require a passcode", owner_round_passcode_path(@round), method: :post, class: "btn-secondary", form_class: "mt-3" %>
          <% end %>
        </div>
      </section>
    </div>
  <% else %>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Started by <span class="font-medium text-stone-900 dark:text-stone-100"><%= @round.owner.username %></span></p>

    <section class="card mt-8 p-6">
      <% if current_user.audience?(@round) %>
        <h2 class="font-semibold">You're attending</h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Vote on each agenda item as it comes up.</p>
        <%= link_to "Go vote", round_agenda_items_path(@round), class: "btn-primary mt-5" %>
      <% else %>
        <h2 class="font-semibold">Join to vote</h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">Become an attendee to get your vote on each agenda item.</p>
        <%= button_to "Join as an attendee", new_round_audience_path(@round), method: :get, class: "btn-primary", form_class: "mt-5" %>
      <% end %>
    </section>
  <% end %>
</div>
