<div class="mx-auto max-w-3xl">
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="page-title mt-2">“<%= @round.title %>”</h1>

  <% if current_user.owner?(@round) %>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".organizer") %></p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <section class="card p-6">
        <h2 class="font-semibold"><%= t(".run") %></h2>
        <ul class="mt-4 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <li><%= link_to t(".agenda_items"), owner_round_agenda_items_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <li><%= link_to t(".attendees"), owner_round_audiences_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <li><%= link_to t(".results"), owner_round_results_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <% if current_user.audience?(@round) %>
            <li><%= link_to t(".vote"), round_agenda_items_path(@round), class: "flex justify-between py-3 hover:text-blue-800 dark:hover:text-blue-400" %></li>
          <% end %>
        </ul>
      </section>

      <section class="card p-6" data-controller="clipboard" data-clipboard-copied-value="<%= t(".copied") %>">
        <h2 class="font-semibold"><%= t(".invite") %></h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".invite_hint") %></p>
        <p class="mt-4 break-all rounded-md bg-stone-50 px-3 py-2 font-mono text-xs text-stone-700 dark:bg-stone-950 dark:text-stone-300" data-clipboard-target="source"><%= @round.url %></p>
        <button type="button" data-clipboard-target="button" data-action="clipboard#copy" class="btn-secondary mt-4"><%= t(".copy") %></button>

        <div id="passcode" class="mt-6 border-t border-stone-100 pt-5 dark:border-stone-800">
          <% if @round.passcode.present? %>
            <p class="text-sm text-stone-600 dark:text-stone-400"><%= t(".passcode_hint") %></p>
            <p class="passcode mt-2 font-mono text-3xl font-semibold tracking-[0.3em]"><%= @round.passcode %></p>
            <div class="mt-4 flex flex-wrap gap-3">
              <%= button_to t(".new_code"), owner_round_passcode_path(@round), method: :post, class: "btn-secondary", form: { data: { turbo_confirm: t(".new_code_confirm"), confirm_detail: t(".new_code_detail"), confirm_button: t(".new_code_button") } } %>
              <%= button_to t(".turn_off"), owner_round_passcode_path(@round), method: :delete, class: "btn-secondary", form: { data: { turbo_confirm: t(".turn_off_confirm"), confirm_button: t(".turn_off") } } %>
            </div>
          <% else %>
            <p class="text-sm text-stone-600 dark:text-stone-400"><%= t(".open") %></p>
            <%= button_to t(".require_passcode"), owner_round_passcode_path(@round), method: :post, class: "btn-secondary", form_class: "mt-3" %>
          <% end %>
        </div>
      </section>
    </div>

  <% else %>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".started_by_html", name: tag.span(@round.owner.username, class: "font-medium text-stone-900 dark:text-stone-100")) %></p>

    <section class="card mt-8 p-6">
      <% if current_user.audience?(@round) %>
        <h2 class="font-semibold"><%= t(".attending") %></h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".attending_hint") %></p>
        <%= link_to t(".go_vote"), round_agenda_items_path(@round), class: "btn-primary mt-5" %>
      <% else %>
        <h2 class="font-semibold"><%= t(".join") %></h2>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-400"><%= t(".join_hint") %></p>
        <%= button_to t(".join_button"), new_round_audience_path(@round), method: :get, class: "btn-primary", form_class: "mt-5" %>
      <% end %>
    </section>
  <% end %>
</div>
