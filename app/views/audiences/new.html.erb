<div class="mx-auto max-w-md py-6">
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="page-title mt-2">“<%= @round.title %>”</h1>
  <p class="mt-2 text-base text-stone-600 dark:text-stone-400"><%= t(".intro") %></p>

  <div class="card mt-8 p-6">
    <%= form_with url: round_audiences_path(@round), method: :post, class: "space-y-5" do |f| %>
      <% if @audience.errors.any? %>
        <ul class="rounded-md bg-red-50 px-3 py-2 text-base text-red-700 dark:bg-red-950 dark:text-red-300">
          <% @audience.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
      <% if @round.passcode.present? %>
        <div>
          <%= label_tag :passcode, Audience.human_attribute_name(:passcode), class: "form-label text-base" %>
          <%= text_field_tag :passcode, nil, required: true, inputmode: "numeric", autocomplete: "off", class: "form-input py-2.5 font-mono text-lg tracking-widest sm:text-lg" %>
          <p class="mt-1 text-sm text-stone-500 dark:text-stone-400"><%= t(".passcode_hint") %></p>
        </div>
      <% end %>
      <p class="text-base"><%= t(".will_attend_as", name: @audience.name) %></p>
      <%= f.submit t(".submit"), class: "btn-primary w-full py-3 text-lg" %>
    <% end %>
  </div>
</div>
