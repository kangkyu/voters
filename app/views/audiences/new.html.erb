<div class="mx-auto max-w-md py-6">
  <p class="eyebrow">Join meeting</p>
  <h1 class="page-title mt-2">“<%= @round.title %>”</h1>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Become an attendee to vote on its agenda items.</p>

  <div class="card mt-8 p-6">
    <%= form_with url: round_audiences_path(@round), model: [@round, @audience], method: :post, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, autofocus: true, class: "form-input" %>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">How the organizer sees you in the attendee list.</p>
      </div>
      <%= f.submit "Attend", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
